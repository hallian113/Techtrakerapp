<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ✅ App Basic Info -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	
	<key>CFBundleDisplayName</key>
	<string>Tech Tracker Pro</string>
	
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	
	<key>CFBundleName</key>
	<string>Tech Tracker Pro</string>
	
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	
	<key>CFBundleSignature</key>
	<string>????</string>
	
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	
	<!-- ✅ iOS Requirements -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	
	<!-- ✅ Launch Screen -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	
	<!-- ✅ Main Storyboard -->
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	
	<!-- ✅ Supported Orientations - iPhone -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<!-- ✅ Supported Orientations - iPad -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<!-- ✅ Frame Rate -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	
	<!-- ✅ Indirect Input Events -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	
	<!-- ============================================= -->
	<!-- ✅ LOCATION PERMISSIONS -->
	<!-- ============================================= -->
	
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Tech Tracker Pro needs your location to track your work hours and show your real-time position to the admin.</string>
	
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Tech Tracker Pro needs background location access to continue tracking your work hours even when the app is not in use.</string>
	
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Tech Tracker Pro needs your location to track your work hours, show your real-time position, and provide accurate attendance records.</string>
	
	<!-- ============================================= -->
	<!-- ✅ OTHER PERMISSIONS -->
	<!-- ============================================= -->
	
	<key>NSMotionUsageDescription</key>
	<string>Tech Tracker Pro uses motion data to improve location accuracy during your work hours.</string>
	
	<key>NSCameraUsageDescription</key>
	<string>Tech Tracker Pro needs access to your camera to take your profile picture.</string>
	
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Tech Tracker Pro needs access to your photo library to set your profile picture.</string>
	
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Tech Tracker Pro needs permission to save attendance reports to your photo library.</string>
	
	<key>NSMicrophoneUsageDescription</key>
	<string>Tech Tracker Pro needs microphone access for voice notes.</string>
	
	<key>NSCalendarsUsageDescription</key>
	<string>Tech Tracker Pro uses calendar to help you manage your work schedule.</string>
	
	<key>NSRemindersUsageDescription</key>
	<string>Tech Tracker Pro uses reminders to notify you about work hours.</string>
	
	<!-- ============================================= -->
	<!-- ✅ BACKGROUND MODES -->
	<!-- ============================================= -->
	
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	
	<!-- ============================================= -->
	<!-- ✅ NETWORK & SECURITY -->
	<!-- ============================================= -->
	
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	
	<!-- ============================================= -->
	<!-- ✅ USER INTERFACE & THEME -->
	<!-- ============================================= -->
	
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	
	<key>UIHomeIndicatorAutoHidden</key>
	<false/>
	
	<key>UIPreferredScreenEdgesDeferringSystemGestures</key>
	<string>all</string>
	
	<!-- ============================================= -->
	<!-- ✅ PUSH NOTIFICATIONS -->
	<!-- ============================================= -->
	
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	
	<!-- ============================================= -->
	<!-- ✅ CANADA SPECIFIC -->
	<!-- ============================================= -->
	
	<key>NSTimeZone</key>
	<string>America/Toronto</string>
	
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
	</array>
	
</dict>
</plist>